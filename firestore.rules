rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && resource.data.ownerId == request.auth.uid; }

    // Perfil: propietario puede leer y modificar solo su propio documento.
    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Las publicaciones públicas se leen desde el servidor con Firebase Admin.
    // El Admin SDK omite reglas; por ello las escrituras de contenido se hacen
    // a través del backend, que verifica Firebase ID tokens y la propiedad.
    match /{collection}/{docId} {
      allow read: if false;
      allow write: if false;
    }
  }
}